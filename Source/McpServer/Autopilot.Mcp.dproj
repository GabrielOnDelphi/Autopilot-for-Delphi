    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <!-- madExcept: arm the freshly linked binary. Without this step madExcept is linked but DEAD:
         no .mes settings inside the exe, no embedded map, so no symbols and no auto saved report.
         The IDE wizard does this on every link; a command line build has no wizard.

         Three deliberate choices, each of which cost a silent failure to learn:
         1. AfterTargets is CoreBuild, NOT Build. delphi-compiler runs MSBuild with /t:rebuild,
            which routes through CoreBuild/Make and never through a target named Build, so
            AfterTargets="Build" simply never fires.
         2. A Target, NOT a PostBuildEvent. delphi-compiler resolves PostBuildEvent with its own
            config argument, which defaults to Debug and is NOT changed by a Config property
            override. A PreRelease build would then run the Debug event and patch the shipping
            exe with the headless Debug.mes. A Target reads the real $(Config) instead.
         3. Exec, so a bad patch fails the build. delphi-compiler records a post build event exit
            code but never acts on it.

         MadExceptDir follows DCC_ExeOutput because delphi-compiler's own scratch build switch
         sets that property to a temporary folder; without this the target would patch the stale
         exe still sitting in the project folder. ProjectDir carries NO trailing backslash in
         Delphi's MSBuild, so the separator is written explicitly.

         CAUTION when editing this comment: XML forbids two consecutive hyphens anywhere inside
         a comment, and forbids a hyphen as the last character before the close. Spelling a
         command line switch here with its two leading hyphens raises MSB4025 and the project
         file will not load at all. That happened on the first build of this target.

         Debug gets the shared headless settings file so an unattended run cannot block on a
         modal box, and never carries the live crash report endpoint. -->
    <Target Name="PatchMadExcept" AfterTargets="CoreBuild">
        <PropertyGroup>
            <MadExceptMes Condition="'$(Config)'=='Debug'">C:\AI\Claude Code\Tools\madExcept\Debug.mes</MadExceptMes>
            <MadExceptMes Condition="'$(Config)'!='Debug'">$(ProjectDir)\Autopilot.Mcp.mes</MadExceptMes>
            <MadExceptDir Condition="'$(DCC_ExeOutput)'==''">$(ProjectDir)</MadExceptDir>
            <MadExceptDir Condition="'$(DCC_ExeOutput)'!=''">$(DCC_ExeOutput.TrimEnd('\'))</MadExceptDir>
        </PropertyGroup>
        <Exec WorkingDirectory="$(ProjectDir)"
              Command="&quot;C:\AI\Claude Code\Tools\madExcept\PatchMadExcept.cmd&quot; &quot;$(MadExceptDir)\Autopilot.Mcp.exe&quot; &quot;$(MadExceptMes)&quot;" />
    </Target>
</Project>
