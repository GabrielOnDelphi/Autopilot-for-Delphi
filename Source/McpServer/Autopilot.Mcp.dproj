    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_Optimize>true</DCC_Optimize>
        <DCC_RangeChecking>true</DCC_RangeChecking>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_RemoteDebug>true</DCC_RemoteDebug>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_Win32)'!=''">
        <DCC_Define>madExcept;$(DCC_Define)</DCC_Define>
        <DCC_RemoteDebug>false</DCC_RemoteDebug>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_3)'!=''">
        <DCC_AssertionsAtRuntime>false</DCC_AssertionsAtRuntime>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_IntegerOverflowCheck>false</DCC_IntegerOverflowCheck>
        <DCC_Optimize>true</DCC_Optimize>
        <DCC_RangeChecking>false</DCC_RangeChecking>
    </PropertyGroup>
    <!-- madExcept crash reporting, only on a PC that has the madExcept patch script.
         Elsewhere the server builds without madExcept: no madshi define, no madExcept packages, no patch step.
         To build without it on such a PC as well, set the MSBuild property UseMadExcept to false. -->
    <PropertyGroup>
        <MadExceptPatchCmd>C:\AI\Tools\madExcept\PatchMadExcept.cmd</MadExceptPatchCmd>
        <MadExceptDebugMes>C:\AI\Tools\madExcept\Debug.mes</MadExceptDebugMes>
        <UseMadExcept Condition="'$(UseMadExcept)'=='' and Exists('$(MadExceptPatchCmd)')">true</UseMadExcept>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseMadExcept)'=='true'">
        <DCC_Define>madshi;$(DCC_Define)</DCC_Define>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseMadExcept)'=='true' and '$(Base_Win32)'!=''">
        <DCC_UsePackage>madBasic_;madExcept_;$(DCC_UsePackage)</DCC_UsePackage>
        <Debugger_DebugSourcePath>c:\Delphi\IDE madShi 510\madExcept\Sources\;$(Debugger_DebugSourcePath)</Debugger_DebugSourcePath>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Mcp\MCPServer.Types.pas"/>
        <DCCReference Include="Mcp\MCPServer.Schema.Generator.pas"/>
        <DCCReference Include="Mcp\MCPServer.Serializer.pas"/>
        <DCCReference Include="Mcp\MCPServer.Tool.Base.pas"/>
        <DCCReference Include="Mcp\MCPServer.Registration.pas"/>
        <DCCReference Include="Mcp\Autopilot.Mcp.JsonRpc.pas"/>
        <DCCReference Include="Mcp\Autopilot.Mcp.Stdio.pas"/>
        <DCCReference Include="..\Bridge\Autopilot.Bridge.Core.pas"/>
        <DCCReference Include="..\Bridge\Autopilot.Bridge.Log.pas"/>
        <DCCReference Include="Common\Autopilot.Mcp.PipeClient.pas"/>
        <DCCReference Include="Common\Autopilot.Mcp.SocketClient.pas"/>
        <DCCReference Include="Common\Autopilot.Mcp.AdbForward.pas"/>
        <DCCReference Include="Autopilot.Mcp.TargetMode.pas"/>
        <DCCReference Include="Autopilot.Mcp.CrashReport.pas"/>
        <DCCReference Include="Autopilot.Mcp.ToolBase.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.Attach.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.ListTree.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.Click.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.GetText.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.SetText.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.SetChecked.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.SetProperty.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.ReadProperty.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.ExecuteAction.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.WaitFor.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.Screenshot.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.SetKeepAwake.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.DismissDialog.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.SendKeys.pas"/>
        <DCCReference Include="Autopilot.Mcp.Tool.CallMethod.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="PreRelease">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_3</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">Autopilot.Mcp.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Deployment Version="5"/>
            <Platforms>
                <Platform value="Android">False</Platform>
                <Platform value="Android64">False</Platform>
                <Platform value="Linux64">False</Platform>
                <Platform value="OSX64">False</Platform>
                <Platform value="OSXARM64">False</Platform>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
                <Platform value="WinARM64EC">False</Platform>
                <Platform value="iOSDevice64">False</Platform>
                <Platform value="iOSSimARM64">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')"/>
    <!-- Patches the settings of the .mes into the linked exe; without it madExcept is linked but inactive. -->
    <Target Name="PatchMadExcept" AfterTargets="CoreBuild" Condition="'$(UseMadExcept)'=='true'">
        <PropertyGroup>
            <MadExceptMes Condition="'$(Config)'=='Debug'">$(MadExceptDebugMes)</MadExceptMes>
            <MadExceptMes Condition="'$(Config)'!='Debug'">$(ProjectDir)\Autopilot.Mcp.mes</MadExceptMes>
            <MadExceptBin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine(&apos;$(ProjectDir)&apos;, &apos;$(FinalOutput)&apos;))))</MadExceptBin>
        </PropertyGroup>
        <Exec WorkingDirectory="$(ProjectDir)" Command="&quot;$(MadExceptPatchCmd)&quot; &quot;$(MadExceptBin)&quot; &quot;$(MadExceptMes)&quot;"/>
    </Target>
</Project>
