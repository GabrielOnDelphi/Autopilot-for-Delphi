        <MSBuild Projects="Tools\DcuBuild\BuildDcu.dproj"/>
    </Target>
    <Target Name="BuildDcu:Clean">
        <MSBuild Projects="Tools\DcuBuild\BuildDcu.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BuildDcu:Make">
        <MSBuild Projects="Tools\DcuBuild\BuildDcu.dproj" Targets="Make"/>
