        <DCC_Define>AUTOPILOT;$(DCC_Define)</DCC_Define>
        <DCC_DcuOutput>$(Platform)_$(Config)</DCC_DcuOutput>
        <DCC_MapFile>3</DCC_MapFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
